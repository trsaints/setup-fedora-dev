export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="dracula"

plugins=(
  git
  docker
  docker-compose
  dotnet
  python
  pip
  poetry
  fzf
  zsh-completions
  zsh-autocomplete
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source "$ZSH/oh-my-zsh.sh"

setopt prompt_subst
zmodload zsh/datetime 2>/dev/null || true

PROMPT_COMMAND_START=0
PROMPT_COMMAND_DURATION=""

prompt_git_segment() {
  local branch
  local git_status
  local line index_state worktree_state
  local has_conflicts=false
  local has_staged=false
  local has_unstaged=false
  local has_untracked=false
  local git_symbol=""
  local git_color_code="%F{green}"

  branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null \
    || git rev-parse --short HEAD 2>/dev/null) || return
  git_status=$(git status --porcelain=v1 --branch 2>/dev/null)

  for line in ${(f)git_status}; do
    [[ "$line" == '## '* ]] && continue
    [[ "$line" == '?? '* ]] && has_untracked=true && continue

    index_state=${line[1,1]}
    worktree_state=${line[2,2]}

    case "$index_state$worktree_state" in
      DD|AU|UD|UA|DU|AA|UU) has_conflicts=true ;;
    esac
    [[ "$index_state" == [MADRC] ]] && has_staged=true
    [[ "$worktree_state" == [MD] ]] && has_unstaged=true
  done

  if [[ "$has_conflicts" == true ]]; then
    git_symbol=""
    git_color_code="%F{red}"
  elif [[ "$has_staged" == true ]]; then
    git_symbol=""
    git_color_code="%F{green}"
  elif [[ "$has_unstaged" == true ]]; then
    git_symbol=""
    git_color_code="%F{yellow}"
  elif [[ "$has_untracked" == true ]]; then
    git_symbol=""
    git_color_code="%F{cyan}"
  elif [[ "$git_status" == *'ahead '* && "$git_status" == *'behind '* ]]; then
    git_symbol="⇅"
    git_color_code="%F{magenta}"
  elif [[ "$git_status" == *'ahead '* ]]; then
    git_symbol="↑"
    git_color_code="%F{magenta}"
  elif [[ "$git_status" == *'behind '* ]]; then
    git_symbol="↓"
    git_color_code="%F{magenta}"
  fi

  printf ' %%F{cyan}%%f %%F{yellow}%%f %s%s%%f %%F{magenta}%s%%f' "$git_color_code" "$git_symbol" "$branch"
}

prompt_command_duration() {
  [[ -n "$PROMPT_COMMAND_DURATION" ]] && printf '%%F{magenta}󰔟%%f %%F{yellow}%s%%f %%F{cyan}%%f ' "$PROMPT_COMMAND_DURATION"
}

custom_prompt_preexec() {
  PROMPT_COMMAND_START=$EPOCHSECONDS
}

custom_prompt_precmd() {
  local elapsed

  PROMPT_COMMAND_DURATION=""
  (( PROMPT_COMMAND_START > 0 )) || return

  elapsed=$(( EPOCHSECONDS - PROMPT_COMMAND_START ))
  PROMPT_COMMAND_START=0

  (( elapsed >= 5 )) || return

  if (( elapsed >= 3600 )); then
    PROMPT_COMMAND_DURATION="$(( elapsed / 3600 ))h $(( elapsed % 3600 / 60 ))m $(( elapsed % 60 ))s"
  elif (( elapsed >= 60 )); then
    PROMPT_COMMAND_DURATION="$(( elapsed / 60 ))m $(( elapsed % 60 ))s"
  else
    PROMPT_COMMAND_DURATION="${elapsed}s"
  fi
}

autoload -Uz add-zsh-hook
add-zsh-hook preexec custom_prompt_preexec
add-zsh-hook precmd custom_prompt_precmd

PROMPT=$'%F{magenta}%B%n%b%f %F{cyan}%f %F{blue}%B%~%b%f$(prompt_git_segment)\n%F{green}❯%f '
RPROMPT='$(prompt_command_duration)%F{blue}%f %F{cyan}%*%f'

export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export PATH="$HOME/.local/bin:$HOME/.dotnet/tools:$PATH"
eval "$(mise activate zsh)"

alias ls='eza --icons --group-directories-first'
alias ll='eza -la --icons --group-directories-first --git'
alias la='eza -a --icons --group-directories-first'
alias cat='bat'
alias grep='rg'
alias top='btop'
alias py='python3'
alias venv='python3 -m venv .venv && source .venv/bin/activate'
alias dc='docker compose'
alias k='kubectl'
alias tf='terraform'

bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^H' backward-kill-word
bindkey '^?' backward-delete-char
bindkey '^[[3;5~' kill-word

autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select

if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

fastfetch 2>/dev/null || true
